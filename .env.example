# Telegram AI Interview Coach - Environment Configuration
# Copy this file to .env and provide your actual secrets. NEVER commit .env to source control!

# Application Environment: 'development' or 'production'
APP_ENV=development

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Base URL where FastAPI is reachable (e.g. http://127.0.0.1:8000 in dev, https://bot.example.com in prod)
WEB_BASE_URL=http://127.0.0.1:8000

# Secret 32 url-safe base64-encoded bytes for Fernet symmetric key encryption
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_encryption_key_here

# SQLite Database file path
DATABASE_PATH=app.db

# Host and Port for FastAPI web server
WEB_HOST=127.0.0.1
WEB_PORT=8000

# Maximum allowed resume upload size in bytes (e.g. 5MB = 5242880 bytes)
MAX_RESUME_SIZE_BYTES=5242880

# Key setup token lifetime in seconds (default: 900 = 15 minutes)
KEY_SETUP_TOKEN_EXPIRY_SECONDS=900

# Optional Testing Groq API key for local development fallback
TESTING_GROQ_API_KEY=

# Default Groq Models
GROQ_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Shared Tavily Search API key (Server-level configuration)
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5

# Clerk Authentication (Web)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
FRONTEND_ORIGIN=http://localhost:3000

